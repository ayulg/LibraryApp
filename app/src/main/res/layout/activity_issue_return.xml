<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Compact Dark Academia Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/btn_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="@color/accent_light"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Issue / Return"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:fontFamily="serif"
                android:gravity="center"/>

            <View
                android:layout_width="50dp"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Issue Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/background_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖 Issue Book"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="serif"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etIssueBookId"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Book ID"
                        android:textColorHint="@color/text_secondary"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp"
                        android:textAllCaps="true"/>

                    <EditText
                        android:id="@+id/etIssueStudentId"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Student ID"
                        android:textColorHint="@color/text_secondary"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:textAllCaps="true"/>

                    <Button
                        android:id="@+id/btnIssue"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="ISSUE BOOK"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="@drawable/btn_primary"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Return Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/background_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 Return Book"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="serif"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etReturnBookId"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Book ID"
                        android:textColorHint="@color/text_secondary"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp"
                        android:textAllCaps="true"/>

                    <EditText
                        android:id="@+id/etReturnStudentId"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Student ID"
                        android:textColorHint="@color/text_secondary"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:textAllCaps="true"/>

                    <Button
                        android:id="@+id/btnReturn"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="RETURN BOOK"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="@drawable/btn_primary"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>