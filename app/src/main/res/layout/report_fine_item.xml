<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/background_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Student Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvReportFineStudentId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S001 - John Smith"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Book Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvReportFineBookId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B001 - Clean Code"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Amount and Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReportFineAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ETB 50.00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/warning"/>

            <TextView
                android:id="@+id/tvReportFineStatus"
                android:layout_width="70dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="Unpaid"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>