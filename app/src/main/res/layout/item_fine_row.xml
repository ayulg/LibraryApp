<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Student Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 "
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvFineStudentId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S001 - John Smith"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Book Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 "
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvFineBookId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B001 - Clean Code"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Amount and Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 "
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvFineAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ETB 0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/warning"/>

            <TextView
                android:id="@+id/tvFineStatus"
                android:layout_width="70dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="Unpaid"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_light"
            android:layout_marginBottom="8dp"/>

        <!-- Pay Button -->
        <Button
            android:id="@+id/btnPayFine"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="PAY FINE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/btn_primary"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>