<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Due Date Settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:fontFamily="serif"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center"/>

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="@color/accent"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/tvCurrentValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current setting: 14 days"
        android:textSize="12sp"
        android:textColor="@color/accent_dark"
        android:background="@color/surface"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Default Due Days"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Number of days students have to return books"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Days:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:layout_marginEnd="16dp"/>

        <EditText
            android:id="@+id/etDueDays"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:inputType="number"
            android:text="14"
            android:gravity="center"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" days"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preview: Due date will be 14 days from issue"
        android:textSize="11sp"
        android:textColor="@color/accent"
        android:background="@color/surface"
        android:padding="12dp"
        android:layout_marginBottom="20dp"
        android:fontStyle="italic"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ℹ️ Note: Changes apply to NEW book issues only"
        android:textSize="9sp"
        android:textColor="@color/warning"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancelDueSettings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/btn_secondary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSaveDueSettings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="SAVE SETTINGS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/btn_primary"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>