<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/background_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top Row: Book Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvReportIssueBookId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B001 - Clean Code"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvReportIssueStudentId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S001 - John Doe"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="end"/>

        </LinearLayout>

        <!-- Middle Row: Dates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvReportIssueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Issued: 2024-01-01"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvReportDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Due: 2024-01-15"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:gravity="end"/>

        </LinearLayout>

        <!-- Status Row -->
        <TextView
            android:id="@+id/tvReportIssueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ON TIME"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:padding="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_status_available"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>