<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E2723"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#D4A373"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8D5B7"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#3E2723"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EDE0D4"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#C4A882"/>
        </shape>
    </item>
</selector>